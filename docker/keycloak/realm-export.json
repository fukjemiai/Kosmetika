{
  "realm": "kosmetika",
  "enabled": true,
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "customer",
        "description": "Customer role"
      },
      {
        "name": "beautician",
        "description": "Beautician/staff role"
      },
      {
        "name": "salon_owner",
        "description": "Salon owner role"
      },
      {
        "name": "admin",
        "description": "System administrator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "kosmetika-web",
      "name": "Kosmetika Customer Portal",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "defaultRoles": ["customer"],
      "protocol": "openid-connect"
    },
    {
      "clientId": "kosmetika-staff",
      "name": "Kosmetika Staff App",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3002/*"],
      "webOrigins": ["http://localhost:3002"],
      "defaultRoles": ["beautician"],
      "protocol": "openid-connect"
    },
    {
      "clientId": "kosmetika-api",
      "name": "Kosmetika API",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "protocol": "openid-connect"
    }
  ],
  "defaultDefaultClientScopes": ["profile", "email", "roles"],
  "internationalizationEnabled": true,
  "supportedLocales": ["cs", "en"],
  "defaultLocale": "cs"
}
