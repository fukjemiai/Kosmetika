{
  "name": "kosmetika",
  "version": "1.0.0",
  "private": true,
  "description": "Beauty booking and billing system",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w packages/api",
    "dev:customer": "npm run dev -w packages/customer-app",
    "dev:admin": "npm run dev -w packages/admin-app",
    "build:shared": "npm run build -w packages/shared",
    "build:api": "npm run build -w packages/api",
    "build:customer": "npm run build -w packages/customer-app",
    "build:admin": "npm run build -w packages/admin-app",
    "build": "npm run build:shared && npm run build:api && npm run build:customer && npm run build:admin",
    "db:migrate": "npm run db:migrate -w packages/api",
    "db:generate": "npm run db:generate -w packages/api",
    "db:seed": "npm run db:seed -w packages/api",
    "lint": "eslint 'packages/*/src/**/*.{ts,tsx}'",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
