# ── Database ──────────────────────────────────────────────────────────────────
# Pro lokální vývoj (apps mimo Docker):
DATABASE_URL="postgresql://kosmetika:kosmetika@localhost:5432/kosmetika?schema=public"
# Pro Docker (apps v kontejnerech) – nastaveno v docker-compose.yml:
# DATABASE_URL="postgresql://kosmetika:kosmetika@postgres:5432/kosmetika?schema=public"

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="kosmetika"
KEYCLOAK_CLIENT_ID="kosmetika-web"
KEYCLOAK_CLIENT_SECRET="change-me"
KEYCLOAK_ADMIN_USER="admin"
KEYCLOAK_ADMIN_PASSWORD="admin"

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=3001
API_URL="http://localhost:3001"
CORS_ORIGINS="http://localhost:3000,http://localhost:3002"

# ── Web (customer portal) ────────────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_KEYCLOAK_URL="http://localhost:8080"
NEXT_PUBLIC_KEYCLOAK_REALM="kosmetika"
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID="kosmetika-web"

# ── Staff app ─────────────────────────────────────────────────────────────────
STAFF_PORT=3002
NEXT_PUBLIC_STAFF_API_URL="http://localhost:3001"
NEXT_PUBLIC_STAFF_KEYCLOAK_CLIENT_ID="kosmetika-staff"
